OPENAI_API_KEY=
# Default LLM for explanations (o3-mini omits temperature per API). Override e.g. OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL=o3-mini
# RAGAS metrics (GET /evaluation/ragas-metrics/...) use a separate model via llm_factory; avoid o-series here.
# RAGAS_LLM_MODEL=gpt-4o-mini
# RAGAS_EMBEDDING_MODEL=text-embedding-3-small
# Optional for o-series: low | medium | high
# OPENAI_REASONING_EFFORT=medium
# OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
CHROMA_DB_PATH=data/chroma/learning_catalog_db
LOG_LEVEL=INFO

# Hybrid retrieval: Chroma + keyword candidate pool size (1-200, default 15)
LEARNING_PATH_TOP_K=15

# Optional: folder that contains user_master.xlsx, completion_data.xlsx, course_master.xlsx
# LEARNING_PATH_RAW_DIR=
# Optional: full paths if filenames or locations differ
# LEARNING_PATH_USER_MASTER_XLSX=
# LEARNING_PATH_COMPLETION_XLSX=
# LEARNING_PATH_COURSE_MASTER_XLSX=
